{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure Assignment0",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/Assignment0",
                "-B",
                "${workspaceFolder}/build/Assignment0",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: build Assignment0",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Assignment0",
                "--target",
                "Transformation"
            ],
            "dependsOn": "CMake: configure Assignment0",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
